{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-empty": "warn"
  },
  "env": {
    "browser": true,
    "es2020": true
  },
  "ignorePatterns": ["dist/**", "src-tauri/**", "node_modules/**"]
}
