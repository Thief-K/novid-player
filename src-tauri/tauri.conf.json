{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NovidPlayer",
  "version": "1.0.0",
  "identifier": "com.novidplayer.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NovidPlayer",
        "width": 1080,
        "height": 680,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["binaries/*"],
    "windows": {
      "nsis": {
        "installerHooks": "installer_hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mkv",
          "avi",
          "mov",
          "wmv",
          "flv",
          "webm",
          "m4v",
          "ts",
          "m2ts",
          "rmvb",
          "3gp",
          "vob",
          "ogv",
          "mpg",
          "mpeg"
        ],
        "name": "Video File",
        "description": "Video file supported by NovidPlayer",
        "role": "Viewer",
        "mimeType": "video/*"
      },
      {
        "ext": ["mp3", "flac", "wav", "aac", "ogg", "m4a", "wma", "opus"],
        "name": "Audio File",
        "description": "Audio file supported by NovidPlayer",
        "role": "Viewer",
        "mimeType": "audio/*"
      }
    ]
  }
}
