{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NovaPlayer",
  "version": "1.0.0",
  "identifier": "com.novaplayer.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NovaPlayer",
        "width": 1080,
        "height": 680,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["binaries/*"]
  }
}
